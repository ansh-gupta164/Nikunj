<% layout("layouts/boilerplate") %>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-1">
                <i class="fa-solid fa-chart-pie me-1"></i> Sentiment Intelligence Dashboard
            </span>
            <h2 class="fw-bold mb-0 text-dark">AI Review Analytics</h2>
            <p class="text-muted small mb-0">Browse aggregated guest feedback, sentiment classifications, and AI summaries across all listings.</p>
        </div>
        <div>
            <a href="/ai/tools" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> All AI Tools
            </a>
        </div>
    </div>

    <!-- Listings Table / Card Grid -->
    <div class="row g-4">
        <% if (!allListings || allListings.length === 0) { %>
            <div class="col-12 text-center py-5">
                <p class="text-muted">No listings available in the database.</p>
            </div>
        <% } else { %>
            <% allListings.forEach(listing => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <img src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80' %>" 
                            class="card-img-top" alt="<%= listing.title %>" style="height: 180px; object-fit: cover;">
                        
                        <div class="card-body p-4 d-flex flex-direction-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 220px;">
                                    <%= listing.title %>
                                </h5>
                                <% 
                                    const reviewCount = listing.reviews ? listing.reviews.length : 0;
                                    const sentiment = (listing.aiReviewSummary && listing.aiReviewSummary.sentiment) ? listing.aiReviewSummary.sentiment : (reviewCount > 0 ? "Pending Analysis" : "No Reviews");
                                    let badgeColor = "bg-secondary-subtle text-secondary";
                                    if (sentiment.includes("Positive")) badgeColor = "bg-success-subtle text-success border-success-subtle";
                                    else if (sentiment.includes("Negative")) badgeColor = "bg-danger-subtle text-danger border-danger-subtle";
                                    else if (sentiment.includes("Mixed")) badgeColor = "bg-warning-subtle text-warning-emphasis border-warning-subtle";
                                    else if (sentiment.includes("Neutral")) badgeColor = "bg-info-subtle text-info-emphasis border-info-subtle";
                                %>
                                <span class="badge <%= badgeColor %> border rounded-pill">
                                    <%= sentiment %>
                                </span>
                            </div>

                            <p class="text-muted small mb-2">
                                <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                            </p>

                            <!-- Review Count -->
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-comments text-muted me-1"></i><%= reviewCount %> <%= reviewCount === 1 ? 'Review' : 'Reviews' %>
                                </span>
                                <span class="text-muted small">• ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %> / night</span>
                            </div>

                            <!-- Summary preview if cached -->
                            <% if (listing.aiReviewSummary && listing.aiReviewSummary.overallSummary) { %>
                                <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    "<%= listing.aiReviewSummary.overallSummary %>"
                                </p>
                            <% } else { %>
                                <p class="text-muted small fst-italic mb-4 flex-grow-1">
                                    <%= reviewCount > 0 ? 'Click below to generate AI review analysis.' : 'No customer reviews available yet.' %>
                                </p>
                            <% } %>

                            <div class="mt-auto pt-2 border-top d-flex gap-2">
                                <a href="/ai/review-insights/<%= listing._id %>" class="btn btn-outline-primary btn-sm rounded-pill w-100">
                                    <i class="fa-solid fa-chart-pie me-1"></i> Deep Insights
                                </a>
                                <a href="/listings/<%= listing._id %>" class="btn btn-light btn-sm rounded-pill border">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
