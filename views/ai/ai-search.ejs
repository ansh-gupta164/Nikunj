<% layout("layouts/boilerplate") %>

<div class="container my-5">
    <!-- Header Banner -->
    <div class="text-center mb-4">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Semantic Search Engine
        </span>
        <h1 class="fw-bold display-6 text-dark mb-2">AI Natural-Language Discovery</h1>
        <p class="text-muted mx-auto" style="max-width: 620px;">
            Describe your dream getaway in your own words. Nikunj AI understands destination, price ranges, and ambiance without manual filters.
        </p>
    </div>

    <!-- Search Box Card -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <form id="aiSearchForm" action="/ai/search" method="GET">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-0 text-danger ps-3">
                            <i class="fa-solid fa-sparkles fs-4"></i>
                        </span>
                        <input type="text" name="q" id="aiSearchInput" class="form-control border-0 fs-6 shadow-none" 
                            placeholder="e.g. Find a peaceful stay in Manali under 5000 rupees with mountain view"
                            value="<%= query || '' %>" required autocomplete="off">
                        
                        <% if (query) { %>
                            <a href="/ai/search" class="btn btn-link text-muted border-0 me-2" title="Clear search">
                                <i class="fa-solid fa-xmark fs-5"></i>
                            </a>
                        <% } %>

                        <button class="btn btn-danger px-4 rounded-3 fw-semibold" type="submit" id="searchSubmitBtn">
                            <span id="searchSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                            <span id="searchText"><i class="fa-solid fa-magnifying-glass me-1"></i> Search</span>
                        </button>
                    </div>
                </form>

                <!-- Sample Search Chips -->
                <div class="pt-3 px-2 border-top mt-3 d-flex align-items-center flex-wrap gap-2">
                    <span class="text-muted small fw-medium me-1">Try asking:</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill sample-chip" 
                        data-query="Peaceful wooden cottage in Manali under 4500 rupees">
                        "Peaceful cottage in Manali under ₹4500"
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill sample-chip" 
                        data-query="Luxury villa in Goa with swimming pool">
                        "Luxury villa in Goa with swimming pool"
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill sample-chip" 
                        data-query="Affordable stay in Jaipur below 3000 rupees">
                        "Affordable stay in Jaipur below ₹3000"
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill sample-chip" 
                        data-query="Houseboat in Alleppey">
                        "Houseboat in Alleppey"
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Alert -->
    <% if (searchError) { %>
        <div class="row justify-content-center mb-4">
            <div class="col-lg-9">
                <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <strong>Search Error:</strong> <%= searchError %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Search Interpretation Breakdown (If query submitted) -->
    <% if (searchResults && searchResults.interpretation) { %>
        <% const interp = searchResults.interpretation; %>
        <div class="row justify-content-center mb-4">
            <div class="col-lg-9">
                <div class="card border-0 bg-success-subtle rounded-4 p-4 shadow-sm border border-success-subtle">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <span class="badge bg-success text-white rounded-pill px-3 py-1 mb-1">
                                <i class="fa-solid fa-microchip me-1"></i> AI Interpretation
                            </span>
                            <h5 class="fw-bold text-dark mb-1"><%= interp.intentSummary %></h5>
                        </div>
                        <span class="badge bg-white text-dark border px-3 py-2 rounded-pill">
                            <%= searchResults.totalCount %> <%= searchResults.totalCount === 1 ? 'Stay Found' : 'Stays Found' %>
                        </span>
                    </div>

                    <!-- Filter pills -->
                    <div class="d-flex flex-wrap gap-2 pt-2">
                        <% if (interp.location) { %>
                            <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                                <i class="fa-solid fa-location-dot text-danger me-1"></i> Destination: <strong><%= interp.location %></strong>
                            </span>
                        <% } %>

                        <% if (interp.maxPrice !== null) { %>
                            <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                                <i class="fa-solid fa-indian-rupee-sign text-success me-1"></i> Max Budget: <strong>₹<%= interp.maxPrice.toLocaleString("en-IN") %></strong>
                            </span>
                        <% } %>

                        <% if (interp.minPrice !== null) { %>
                            <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                                <i class="fa-solid fa-tag text-primary me-1"></i> Min Price: <strong>₹<%= interp.minPrice.toLocaleString("en-IN") %></strong>
                            </span>
                        <% } %>

                        <% if (interp.keywords && interp.keywords.length > 0) { %>
                            <% interp.keywords.forEach(kw => { %>
                                <span class="badge bg-white text-muted border rounded-pill px-2 py-1 small">
                                    #<%= kw %>
                                </span>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Unsupported Filters Warning if user asked for non-schema fields -->
                    <% if (interp.unsupportedFilters && interp.unsupportedFilters.length > 0) { %>
                        <div class="mt-3 pt-2 border-top border-success-subtle small text-muted">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            <em>Note: Filters (<%= interp.unsupportedFilters.join(", ") %>) are not currently indexed in the stay schema, but matching was performed on available property descriptions.</em>
                        </div>
                    <% } %>

                    <% if (searchResults.isRelaxed) { %>
                        <div class="mt-2 small text-warning-emphasis">
                            <i class="fa-solid fa-circle-exclamation me-1"></i>
                            <em>Showing broader destination results matching "<%= interp.location %>" as no properties met all criteria simultaneously.</em>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Search Results Grid -->
    <% if (searchResults) { %>
        <% if (searchResults.listings && searchResults.listings.length > 0) { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
                <% searchResults.listings.forEach(listing => { %>
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden listing-card">
                            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                                <img src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80' %>" 
                                    class="card-img-top" alt="<%= listing.title %>" style="height: 220px; object-fit: cover;">
                            </a>

                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 220px;">
                                        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                                            <%= listing.title %>
                                        </a>
                                    </h6>
                                    <span class="fw-bold text-danger">
                                        ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %> <small class="text-muted fw-normal">/ night</small>
                                    </span>
                                </div>

                                <p class="text-muted small mb-2">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                                </p>

                                <!-- AI Match Rationale Pills -->
                                <div class="mt-2 mb-3">
                                    <small class="text-muted d-block mb-1 fw-semibold text-uppercase" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-wand-magic-sparkles text-danger me-1"></i>Why it matches:
                                    </small>
                                    <div class="d-flex flex-column gap-1">
                                        <% if (listing.matchReasons && listing.matchReasons.length > 0) { %>
                                            <% listing.matchReasons.slice(0, 2).forEach(reason => { %>
                                                <span class="badge bg-light text-dark text-start border rounded-3 p-1 px-2 fw-normal text-truncate" style="font-size: 0.75rem;">
                                                    <i class="fa-solid fa-check text-success me-1"></i><%= reason %>
                                                </span>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="mt-auto pt-2 border-top d-flex gap-2">
                                    <a href="/listings/<%= listing._id %>" class="btn btn-dark btn-sm rounded-pill w-100">
                                        View Details
                                    </a>
                                    <a href="/ai/review-insights/<%= listing._id %>" class="btn btn-outline-primary btn-sm rounded-pill" title="AI Review Insights">
                                        <i class="fa-solid fa-chart-pie"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="row justify-content-center my-5">
                <div class="col-md-7 text-center py-5">
                    <i class="fa-solid fa-magnifying-glass-chart text-muted display-3 mb-3"></i>
                    <h4 class="fw-bold text-dark">No Matching Properties Found</h4>
                    <p class="text-muted mx-auto" style="max-width: 440px;">
                        We couldn't find any listings matching your specific parameters. Try increasing your maximum budget, checking nearby cities, or asking for general destination recommendations.
                    </p>
                    <a href="/listings" class="btn btn-outline-danger rounded-pill px-4 me-2">
                        Explore All Listings
                    </a>
                    <a href="/ai/search" class="btn btn-light rounded-pill px-4 border">
                        Reset Search
                    </a>
                </div>
            </div>
        <% } %>
    <% } %>
</div>

<!-- Search UX Interaction Script -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchForm = document.getElementById("aiSearchForm");
    const searchInput = document.getElementById("aiSearchInput");
    const submitBtn = document.getElementById("searchSubmitBtn");
    const spinner = document.getElementById("searchSpinner");
    const btnText = document.getElementById("searchText");

    // Sample chip click autofill
    document.querySelectorAll(".sample-chip").forEach(chip => {
        chip.addEventListener("click", function () {
            const query = this.getAttribute("data-query");
            searchInput.value = query;
            searchForm.submit();
        });
    });

    // Form submit loading state
    if (searchForm) {
        searchForm.addEventListener("submit", function () {
            submitBtn.disabled = true;
            spinner.classList.remove("d-none");
            btnText.innerHTML = "Interpreting...";
        });
    }
});
</script>
