<% layout("layouts/boilerplate") %>

    <div class="row">
        <div class="col col-md-8 offset-2">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Create A New Listing</h2>
                <a href="/ai/listing-generator" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>AI Listing Generator
                </a>
            </div>

            <div id="aiPrefillNotice" class="alert alert-success alert-dismissible fade show d-none" role="alert">
                <i class="fa-solid fa-wand-magic-sparkles me-2"></i>
                <strong>Pre-filled with Nikunj AI!</strong> Review the generated title and description, upload your photo, and publish when ready.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <form action="/listings" method="POST" enctype="multipart/form-data" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="listing[title]">Title</label>
                    <input name="listing[title]" id="listing[title]" class="form-control" placeholder="Title" required>
                    <div class="valid-feedback">Title looks Good😀</div>
                </div>

                <div class="mb-3">
                    <label for="listing[description]">Description</label>
                    <textarea name="listing[description]" id="listing[description]" class="form-control"
                        placeholder="Description" required></textarea>
                    <div class="invalid-feedback">Description should be valid</div>

                </div>

                

                <div class="mb-3">
                    <label for="listing[image]">Image Link</label>
                    <input name="listing[image]" id="listing[image]" type="file"
                        class="form-control" required
                        >
                </div>


                <div class="row">
                    <div class="mb-3 col-sm-12 col-md-4">
                        <label for="listing[price]">Price</label>
                        <input type="number" name="listing[price]" id="listing[price]" class="form-control"
                            placeholder="999" required
                            >
                            <div class="invalid-feedback">Price should be valid</div>

                    </div>

                    <div class="mb-3 col-sm-12 col-md-8">
                        <label for="listing[country]">Country</label>
                        <input name="listing[country]" id="listing[country]" class="form-control" placeholder="India"
                            required
                            >
                            <div class="invalid-feedback">Country should be valid</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="listing[location]">Location</label>
                    <input name="listing[location]" id="listing[]" class="form-control"
                        placeholder="Omkareshwar, Madhya Pradesh" 
                     required
                     >
                     <div class="invalid-feedback">Location should be valid</div>
                </div>

                <button class="add-btn btn btn-dark mt-2">Add</button>
                <br><br>
            </form>

            <script>
            document.addEventListener("DOMContentLoaded", function () {
                const prefillRaw = sessionStorage.getItem("nikunj_ai_prefill");
                if (prefillRaw) {
                    try {
                        const data = JSON.parse(prefillRaw);
                        const titleInput = document.querySelector('input[name="listing[title]"]');
                        const descInput = document.querySelector('textarea[name="listing[description]"]');
                        const priceInput = document.querySelector('input[name="listing[price]"]');
                        const locInput = document.querySelector('input[name="listing[location]"]');

                        if (titleInput && data.title) titleInput.value = data.title;
                        if (descInput && data.description) descInput.value = data.description;
                        if (priceInput && data.price) priceInput.value = data.price;
                        if (locInput && data.location) locInput.value = data.location;

                        const notice = document.getElementById("aiPrefillNotice");
                        if (notice) notice.classList.remove("d-none");

                        sessionStorage.removeItem("nikunj_ai_prefill");
                    } catch (e) {
                        console.error("Error reading AI prefill data:", e);
                    }
                }
            });
            </script>
        </div>
    </div>