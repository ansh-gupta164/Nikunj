<% layout("layouts/boilerplate") %>

    <!-- listing  -->
    <div class="row mt-3">
        <div class="col-md-8 offset-3">
            <h1>
                <%= listing.title %>
            </h1>
            <div class="card listing-card col-8 show-card">
                <img class="card-img-top show-img " src="<%= listing.image.url %>" alt="Card image cap">
                <div class="card-body ">

                    <p class="card-text">
                        Owned By @<i>
                            <%= listing.owner ? listing.owner.username : "Anonymous" %>
                        </i>
                    </p>

                    <p class="card-text">
                        <%= listing.description %>
                    </p>
                    <p class="card-text">&#8377;<%= listing.price.toLocaleString("en-IN") %>
                    </p>
                    <p class="card-text">
                        <%= listing.location %>
                    </p>
                    <p class="card-text">
                        <%= listing.country %>
                    </p>
                </div>
            </div>
        </div>

        <!-- buttons -->
            <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
            <div class="show-btns mb-3">
                <a href="/ai/listing-generator?listingId=<%= listing._id %>" class="btn btn-outline-danger col-md-2 offset-3 me-2 rounded-pill">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>AI Polish
                </a>
                <a href="/listings/<%= listing._id %>/edit" class="edit-btn btn btn-dark col-md-1 me-2 rounded-pill">Edit</a>
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="edit-btn btn btn-dark rounded-pill">delete</button>
                </form>

            </div>
            <% } %>
    </div>

    <!-- AI Review Intelligence Widget -->
    <div class="col-md-8 offset-3 mt-4 mb-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center">
                    <div class="bg-danger-subtle text-danger p-2 rounded-3 me-2">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Nikunj AI Review Intelligence</h5>
                        <small class="text-muted">Instant generative analysis of actual customer feedback</small>
                    </div>
                </div>
                <div>
                    <a href="/ai/review-insights/<%= listing._id %>" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        Deep Insights <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <% if (!listing.reviews || listing.reviews.length === 0) { %>
                <div class="p-3 bg-light rounded-3 mt-2">
                    <p class="text-muted small mb-0">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i> No guest reviews yet. Be the first to review this stay!
                    </p>
                </div>
            <% } else { %>
                <% const aiSummary = listing.aiReviewSummary; %>
                <% if (aiSummary && aiSummary.overallSummary) { %>
                    <div class="p-3 bg-light rounded-3 mt-2">
                        <p class="text-dark small mb-2">"<%= aiSummary.overallSummary %>"</p>
                        
                        <div class="d-flex align-items-center flex-wrap gap-2 small text-muted border-top pt-2">
                            <% 
                                let badgeStyle = "bg-primary-subtle text-primary border-primary-subtle";
                                if (aiSummary.sentiment && aiSummary.sentiment.includes("Positive")) badgeStyle = "bg-success-subtle text-success border-success-subtle";
                                else if (aiSummary.sentiment && aiSummary.sentiment.includes("Negative")) badgeStyle = "bg-danger-subtle text-danger border-danger-subtle";
                                else if (aiSummary.sentiment && aiSummary.sentiment.includes("Mixed")) badgeStyle = "bg-warning-subtle text-warning-emphasis border-warning-subtle";
                            %>
                            <span class="badge <%= badgeStyle %> border rounded-pill px-2 py-1">
                                Sentiment: <%= aiSummary.sentiment || 'Positive' %>
                            </span>
                            <span>• <%= aiSummary.reviewsAnalyzedCount %> reviews analyzed</span>
                            <% if (aiSummary.frequentlyAppreciated && aiSummary.frequentlyAppreciated.length > 0) { %>
                                <span>• Top praised: <%= aiSummary.frequentlyAppreciated.slice(0, 2).join(", ") %></span>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <div class="p-3 bg-light rounded-3 mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <p class="text-muted small mb-0">
                            <i class="fa-solid fa-sparkles text-danger me-1"></i> <%= listing.reviews.length %> reviews waiting to be summarized by Gemini AI.
                        </p>
                        <a href="/ai/review-insights/<%= listing._id %>" class="btn btn-sm btn-dark rounded-pill px-3">
                            <i class="fa-solid fa-chart-pie me-1"></i> Generate AI Analysis
                        </a>
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>

    <!-- rating  -->

    <div class="col-md-8 offset-3 mt-3 mb-3">
        <hr>
        <% if(currUser){ %>


            <h4>Leave Rating</h4>


            <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <!-- 
                <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]"> -->

                <div class="mt-3 mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                            aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" class="form-control " id="comment" rows="5" cols="20"
                        placeholder="add your comment" required></textarea>
                </div>
                <div>
                    <textarea name="" class="invalid-feedback" id="">enter comment</textarea>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
            <% } %>




                <!-- review  -->
                <h4>All Reviews</h4>
                <div class="row mb-3">
                    <% for(review of listing.reviews){ %>
                        <div class="card   mb-3 p-3  col-5 ms-3">
                            <div class="card-body">
                                <h5 class="card-title">@<%= review.author.username %>
                                </h5>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                </p>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>

                            </div>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                method="post">
                                <button class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                        <%}%>
                </div>

    </div>